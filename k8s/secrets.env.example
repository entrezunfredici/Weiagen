# =============================================================================
#  Modèle du Secret Kubernetes attendu par les manifests k8s/prod/ et
#  k8s/preprod/ (weiagen-prod-secrets / weiagen-preprod-secrets).
#
#  Ce dépôt ne crée PAS ce Secret (il contient des valeurs sensibles qui n'ont
#  rien à faire dans le dépôt). Il est créé à la main, une fois par namespace.
#
#  1. Copier ce fichier en `secrets.env` (ignoré par git) et remplir les valeurs
#     — voir docker-compose.yml pour le détail/contexte de chaque variable.
#  2. Créer le Secret :
#       kubectl create secret generic weiagen-prod-secrets \
#         -n weiagen --from-env-file=k8s/secrets.env
#       kubectl create secret generic weiagen-preprod-secrets \
#         -n weiagen-preprod --from-env-file=k8s/secrets.env
#  3. Supprimer `secrets.env` du disque
#
#  Pour faire tourner une valeur plus tard :
#       kubectl create secret generic weiagen-prod-secrets -n weiagen \
#         --from-env-file=k8s/secrets.env --dry-run=client -o yaml | kubectl apply -f -
#       kubectl rollout restart deployment/weiagen-prod-hermes -n weiagen
# =============================================================================

# ── Dashboard Hermes (basic auth) ─────────────────────────────────────────────
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# ── Slack (app Slack — voir docker-compose.yml pour le détail) ───────────────
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# ── odoo-plugin — chiffrement Fernet des secrets au repos ───────────────────
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Perdre cette clé rend les secrets déjà chiffrés irrécupérables.
ODOO_PLUGIN_ENCRYPTION_KEY=
