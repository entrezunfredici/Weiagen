# Copy to .env and fill in — never commit .env (see .gitignore).
# See docker-compose.yml for the full context/comment on each variable.

# ── Container user (avoid root-owned files under ~/.hermes) ──────────────────
HERMES_UID=1000
HERMES_GID=1000

# ── Dashboard (http://127.0.0.1:9119, basic auth) ─────────────────────────────
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# ── Slack (native Hermes platform — from the Slack app config) ───────────────
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Comma-separated Slack user IDs, or leave empty (see SLACK_ALLOW_ALL_USERS).
SLACK_ALLOWED_USERS=
# Comma-separated Slack channel IDs the bot responds in, or leave empty for all.
SLACK_ALLOWED_CHANNELS=
SLACK_ALLOW_ALL_USERS=true

# ── odoo-plugin: Fernet key encrypting secrets at rest in the file keyring ────
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes existing encrypted secrets unrecoverable.
ODOO_PLUGIN_ENCRYPTION_KEY=

# ── rights-plugin: TTL (seconds) of signed MCP identity tokens, empty = 300 ───
RIGHTS_MCP_TOKEN_TTL_SECONDS=

# ── audit-plugin: log retention in days, empty = 90, 0 = forever ─────────────
AUDIT_RETENTION_DAYS=
# Registers the audit_search agent tool — off by default (see audit-plugin/README.md).
AUDIT_AGENT_TOOL_ENABLED=

# ── docs-plugin: extra absolute dirs docs_create_* may write to, comma-separated ──
DOCS_OUTPUT_DIRS=

# ── Remote server deploy only (docker-compose.server.yml) — the custom image
#    pushed to Docker Hub, e.g. yourdockerhubuser/weiagen_hermes:latest ───────
HERMES_IMAGE=
